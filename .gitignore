# exclude all
/*

# include important folders
# need gradle 
!gradle/
!gradlew
!gradlew.bat
!build.gradle
!settings.gradle
!gradle.properties
!crowdin.yml

# Scripts
!/scripts
/scripts/node_modules
!/buildSrc
/buildSrc/build
/buildSrc/.gradle

# include markdowns
!*.md
!LICENSE

# include sourcecode
!docs/
!src/
/docs/crafting-v2-migration/
/docs/local-notes/
/src/generated/resources/.cache/
!/guidebook
/guidebook/sandbox

# Build outputs and local run artifacts
/build/
/buildSrc/build/
/.gradle/
/out/
/logs/
/run/

# Local IDE/editor state
/.idea/
/.vscode/
*.iml
*.ipr
*.iws

# Local assistant/workspace state
/.superpowers/
/.codex/

# Local secrets, credentials and proxy/subscription configs
/.env
/.env.*
/local.properties
/secrets.properties
/credentials.properties
/private.properties
/clash*.yml
/clash*.yaml
/proxy*.yml
/proxy*.yaml
/subscription*.txt
/subscription*.yml
/subscription*.yaml
/sub-url*.txt

# Local reference source trees copied into this workspace
/Applied-Energistics-2-Unofficial-master/

# include git important files
!.gitmodules
!.gitignore
!.gitattributes
!.git-blame-ignore-revs

# code format to reduce noise in git commits
!codeformat/

# Github specific files and directories
!.github/

# Explicit ignores
Thumbs.db
Desktop.ini
.DS_Store
*.log
